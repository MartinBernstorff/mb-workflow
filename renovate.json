{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "* 9 * * 1-5"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "automergeSchedule": [
    "* 9 * * 1-5"
  ],
  "pinDigests": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* 9 * * 1-5"
    ]
  },
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  },
  "pep621": {
    "enabled": true
  }
}
